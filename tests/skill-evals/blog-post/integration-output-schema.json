{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reportedFiles": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["status", "questions", "reportedFiles"],
  "additionalProperties": false
}
