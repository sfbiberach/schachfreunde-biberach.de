{
  "name": "schachfreunde-biberach.de",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "predev": "node scripts/prepare-nuxt-dev-cache.mjs",
    "dev": "cross-env NUXT_LOCK=1 nuxt dev",
    "build": "cross-env NITRO_PRESET=cloudflare_module NUXT_LOCK=1 NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "generate": "cross-env NUXT_LOCK=1 nuxt generate && node scripts/validate-generated-output.mjs",
    "preview": "nuxt preview",
    "serve": "wrangler --cwd .output/server dev --config wrangler.json",
    "skill:eval": "node tests/skill-evals/blog-post/run-evals.mjs",
    "skill:eval:smoke": "node tests/skill-evals/blog-post/run-evals.mjs --case simple-proofreading",
    "skill:eval:integration": "node tests/skill-evals/blog-post/run-integration-evals.mjs",
    "lint": "eslint . && pnpm contentcheck",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "generate-pwa-assets": "pwa-assets-generator",
    "postbuild": "node scripts/validate-generated-output.mjs",
    "pregenerate": "pnpm lint",
    "content:format": "nuxt prepare && node scripts/format-content.mjs --write",
    "contentcheck": "nuxt prepare && node scripts/format-content.mjs && node scripts/validate-content.mjs",
    "postinstall": "nuxt prepare",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@happydesigns/nuxt-variants": "^0.0.6",
    "@happydesigns/ui": "^0.16.0",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.89",
    "@nuxt/content": "^3.15.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^1.3.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/seo": "^5.3.6",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "feed": "^6.0.0",
    "nuxt-studio": "^1.7.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^26.1.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "h3": "1.15.11",
    "js-yaml": "4.1.1",
    "mdclint": "^0.1.2",
    "nostics": "1.1.4",
    "nuxt": "^4.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.110.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
